    "cac": "^7.1.0",
    "esbuild": "^0.28.2",
    "picocolors": "^1.1.1",
    "ws": "^8.22.1",
    "levelojs": "^2.3.0"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
