{
  "name": "levelo-cli",
  "version": "0.1.0",
  "description": "Official CLI and dev bundler for LeveloJS",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "levelo": "./bin/levelo.js"
  },
  "files": [
